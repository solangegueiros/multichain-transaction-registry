# Copy this file to .env and fill it in. Never commit .env.
# Public values (RPC, contract address) live in project.config.json.

# Private key of the account that deploys and becomes the contract owner (with 0x prefix)
ETH_PRIVATE_KEY=

# Etherscan API key, used for contract verification
ETHERSCAN_API_KEY=

# --- Chainlink CRE workflow (workflow-registry/) ---

# Observer API key, sent in the X-Observer-Key header.
# Mapped in secrets.yaml to the secret OBSERVER_API_KEY.
API_OBSERVER_KEY=

# Private key of the account the CRE CLI uses to send transactions in a simulation
# with --broadcast and to deploy the workflow (64 hex characters, without 0x prefix)
CRE_ETH_PRIVATE_KEY=
