# Optional. Copy to .env.local to point the app to another deployment, such as a local
# Hardhat node. Without this file the app uses project.config.json, at the repository root.
# No secret goes here: everything in a VITE_ variable ends up in the built site.

VITE_RPC_URL=
VITE_TX_REGISTRY_ADDRESS=
VITE_FUND_REGISTRY_ADDRESS=
VITE_ORDER_REGISTRY_ADDRESS=
VITE_RECEIVER_ADDRESS=
