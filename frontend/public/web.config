<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS (Plesk and similar Windows hosting): sends the calls of the panel to the Observer
     API through observer-api.php. Needs the IIS URL Rewrite module and PHP.
     See "Publicar" in frontend/README.md. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Observer API" stopProcessing="true">
          <match url="^observer-api/(staging|production)/(.*)$" />
          <action type="Rewrite" url="observer-api.php?env={R:1}&amp;path={R:2}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
