{
  "name": "multichain-tx-registry-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode staging",
    "dev:production": "vite --mode production",
    "build": "tsc --noEmit && vite build --mode staging",
    "build:production": "tsc --noEmit && vite build --mode production",
    "preview": "vite preview --mode staging",
    "preview:production": "vite preview --mode production",
    "typecheck": "tsc --noEmit",
    "sync-abi": "node scripts/sync-abi.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "multichain-tx-registry-root": "file:..",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^5.4.10"
  }
}
